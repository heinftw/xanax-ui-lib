    self:addCycle(ttl)
    if opts.Sub then
        mk("TextLabel", {Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = opts.Sub, FontFace = self.font, TextSize = 12, TextColor3 = c.sub, ZIndex = 12, LayoutOrder = 2}, pop)
    end
    mk("TextLabel", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = opts.Body or "", FontFace = self.font, TextSize = 14, TextColor3 = c.text, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 12, LayoutOrder = 3}, pop)
    local btnRow = mk("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, ZIndex = 12, LayoutOrder = 4}, pop)
    mk("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center}, btnRow)
    for _, b in ipairs(opts.Buttons or {{"ok shhh"}}) do
        local bt, bcb = b[1], b[2]
        local bb = mk("TextButton", {Size = UDim2.fromOffset(110, 30), BackgroundColor3 = c.off, Text = bt, FontFace = self.font, TextSize = 13, TextColor3 = c.text, ZIndex = 12}, btnRow)
        corner(bb, 6)
        bb.Activated:Connect(function()
            self:Click()
            modal:Destroy()
            if bcb then bcb() end
        end)
    end
    return modal
end

function Library:Destroy()
    self.gui:Destroy()
end

return Library
