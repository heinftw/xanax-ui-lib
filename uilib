local plrs, uis = game:GetService("Players"), game:GetService("UserInputService")
local ts, rs = game:GetService("TweenService"), game:GetService("RunService")
local http, ssvc = game:GetService("HttpService"), game:GetService("SoundService")
local lp = plrs.LocalPlayer

local function mk(class, props, parent)
    local i = Instance.new(class)
    for k, v in next, props do i[k] = v end
    i.Parent = parent
    return i
end

local function corner(p, r)
    return mk("UICorner", {CornerRadius = UDim.new(0, r)}, p)
end

local function fmt(v)
    return v % 1 == 0 and tostring(math.floor(v)) or string.format("%.1f", v)
end

local Library = {}
Library.__index = Library

local Tab = {}
Tab.__index = Tab

local function reg(tab, label, kind, get, set)
    if not tab.noSave then table.insert(tab.lib.elements, {label = label, kind = kind, get = get, set = set}) end
end

function Library.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Library)
    self.font = Font.new(opts.Font or "rbxassetid://12187377325")
    self.image = opts.Image or "rbxthumb://type=Asset&id=71976807018315&w=420&h=420"
    self.sfxId = opts.Sfx or "rbxassetid://124476359159008"
    self.colors = {
        black = opts.Black or Color3.fromRGB(0, 0, 0),
        bar = opts.Bar or Color3.fromRGB(15, 15, 15),
        off = opts.Off or Color3.fromRGB(65, 65, 65),
        on = opts.On or Color3.fromRGB(105, 105, 105),
        track = opts.Track or Color3.fromRGB(45, 45, 45),
        fill = opts.Fill or Color3.fromRGB(180, 180, 180),
        text = opts.Text or Color3.fromRGB(230, 230, 230),
        sub = opts.SubText or Color3.fromRGB(140, 140, 140),
    }
    self.gui = mk("ScreenGui", {Name = opts.Name or "xanax", ResetOnSpawn = false, DisplayOrder = 999, IgnoreGuiInset = true}, gethui and gethui() or lp:WaitForChild("PlayerGui"))
    self.cycling = {}
    self.phase = 0
    self.elements = {}
    self.currentCfg = nil
    self.fs = (writefile and readfile and isfile and listfiles and isfolder and makefolder) and true or false
    self.cfgFolder = opts.ConfigFolder or (self.gui.Name .. "_cfgs")
    self.metaPath = self.cfgFolder .. "/_meta.json"
    self.meta = {}
    if self.fs then
        if not isfolder(self.cfgFolder) then pcall(makefolder, self.cfgFolder) end
        if isfile(self.metaPath) then
            local ok, d = pcall(function() return http:JSONDecode(readfile(self.metaPath)) end)
            if ok and type(d) == "table" then self.meta = d end
        end
    end
    self.sfxVol = opts.SfxVolume or 2
    self.pool, self.poolIdx = {}, 1
    for i = 1, 8 do
        local s = Instance.new("Sound")
        s.SoundId = self.sfxId
        s.Volume = self.sfxVol
        s.Parent = ssvc
        table.insert(self.pool, s)
    end
    local conn
    conn = rs.RenderStepped:Connect(function()
        local t = os.clock()
        for _, e in ipairs(self.cycling) do
            if e.lbl.Parent then
                local v = math.floor((math.sin((t - e.phase) * 2) * 0.5 + 0.5) * 255)
                e.lbl.TextColor3 = Color3.fromRGB(v, v, v)
            end
        end
    end)
    self.gui.Destroying:Connect(function() conn:Disconnect() end)
    return self
end

function Library:Click()
    local s = self.pool[self.poolIdx]
    self.poolIdx = self.poolIdx % #self.pool + 1
    s.Volume = self.sfxVol
    s.TimePosition = 0
    s:Play()
end

function Library:_sanitize(n)
    n = tostring(n):gsub("[^%w%s%-_]", "")
    return (n:gsub("^%s*(.-)%s*$", "%1"))
end

function Library:_cfgPath(n)
    return self.cfgFolder .. "/" .. n .. ".json"
end

function Library:_listCfgs()
    local names = {}
    if not self.fs then return names end
    for _, f in ipairs(listfiles(self.cfgFolder)) do
        local n = f:match("([^/\\]+)%.json$")
        if n and n ~= "_meta" then table.insert(names, n) end
    end
    table.sort(names)
    return names
end

function Library:_readCfg(n)
    local ok, d = pcall(function() return http:JSONDecode(readfile(self:_cfgPath(n))) end)
    if ok and type(d) == "table" then return d end
end

function Library:_writeMeta()
    if self.fs then pcall(writefile, self.metaPath, http:JSONEncode(self.meta)) end
end

function Library:SaveCfg(n)
    if not self.fs then return false, "no fs" end
    local data = {}
    for _, e in ipairs(self.elements) do data[e.label] = e.get() end
    local ok = pcall(writefile, self:_cfgPath(n), http:JSONEncode(data))
    if not ok then return false, "encode failed" end
    self.meta.last = n
    self:_writeMeta()
    return true
end

function Library:LoadCfg(n)
    if not self.fs then return false end
    local data = self:_readCfg(n)
    if not data then return false end
    for _, e in ipairs(self.elements) do
        local v = data[e.label]
        if v ~= nil then
            if e.kind == "bind" then
                local ok, k = pcall(function() return Enum.KeyCode[tostring(v)] end)
                v = ok and k or nil
            end
            if v ~= nil then e.set(v) end
        end
    end
    self.meta.last = n
    self:_writeMeta()
    return true
end

function Library:DeleteCfg(n)
    if not self.fs then return false end
    local p = self:_cfgPath(n)
    local del = delfile or os.remove
    if del then pcall(del, p) end
    return not isfile(p)
end

local function buildSettings(lib, win)
    local c = lib.colors
    local s = win:Tab("settings", false)
    s.noSave = true
    s.btn.LayoutOrder = 10000
    s:Section("configs")
    local nameBox = s:Textbox("cfg name", "name your config...")
    lib._cfgBox = nameBox
    local cfgDrop = s:Dropdown("cfg", lib:_listCfgs())
    lib._cfgDrop = cfgDrop
    local function save(n, verb)
        local ok = lib:SaveCfg(n)
        if not ok then lib:Notify({Title = "xanax", Body = "saving failed on your executor"}) return end
        lib.currentCfg = n
        cfgDrop.Refresh(lib:_listCfgs())
        cfgDrop.Set(n, true)
        lib:Notify({Title = "xanax", Body = ('%s "%s"'):format(verb or "saved", n)})
    end
    s:Button("save config", function()
        local n = lib:_sanitize(nameBox.Text)
        if not lib.fs then lib:Notify({Title = "xanax", Body = "your executor can't save files"}) return end
        if n == "" then lib:Notify({Title = "xanax", Body = "type a name first"}) return end
        if isfile(lib:_cfgPath(n)) then
            lib:Popup({Title = "xanax", Sub = "hold on...", Body = ('are you sure you wanna overwrite "%s"?'):format(n), Buttons = {{"yes", function() save(n) end}, {"no"}}})
        else
            save(n)
        end
    end)
    s:Button("load config", function()
        local n = cfgDrop.Get()
        if not lib.fs then lib:Notify({Title = "xanax", Body = "your executor can't save files"}) return end
        if not n or not isfile(lib:_cfgPath(n)) then lib:Notify({Title = "xanax", Body = "pick a cfg from the dropdown first"}) return end
        if lib:LoadCfg(n) then
            lib.currentCfg = n
            nameBox.Text = n
            lib:Notify({Title = "xanax", Body = ('loaded "%s"'):format(n)})
        end
    end)
    s:Button("overwrite current", function()
        local n = lib.currentCfg
        if not lib.fs then lib:Notify({Title = "xanax", Body = "your executor can't save files"}) return end
        if not n then lib:Notify({Title = "xanax", Body = "save one first"}) return end
        lib:Popup({Title = "xanax", Sub = "hold on...", Body = ('are you sure you wanna overwrite "%s"?'):format(n), Buttons = {{"yes", function() save(n, "overwrote") end}, {"no"}}})
    end)
    s:Button("delete config", function()
        local n = cfgDrop.Get()
        if not lib.fs then lib:Notify({Title = "xanax", Body = "your executor can't save files"}) return end
        if not n or not isfile(lib:_cfgPath(n)) then lib:Notify({Title = "xanax", Body = "pick a cfg from the dropdown first"}) return end
        lib:Popup({Title = "xanax", Sub = "hold on...", Body = ('are you sure you wanna delete "%s"?'):format(n), Buttons = {{"yes", function()
            lib:DeleteCfg(n)
            if lib.currentCfg == n then lib.currentCfg = nil end
            if lib.meta.autoLoad == n then lib.meta.autoLoad = nil lib:_writeMeta() end
            cfgDrop.Refresh(lib:_listCfgs())
            lib:Notify({Title = "xanax", Body = ('deleted "%s"'):format(n)})
        end}, {"no"}}})
    end)
    s:Button("set as auto load", function()
        local n = cfgDrop.Get()
        if not lib.fs then lib:Notify({Title = "xanax", Body = "your executor can't save files"}) return end
        if not n or not isfile(lib:_cfgPath(n)) then lib:Notify({Title = "xanax", Body = "pick a cfg from the dropdown first"}) return end
        if lib.meta.autoLoad == n then
            lib.meta.autoLoad = nil
            lib:_writeMeta()
            lib:Notify({Title = "xanax", Body = ('auto load cleared for "%s"'):format(n)})
        else
            lib.meta.autoLoad = n
            lib:_writeMeta()
            lib:Notify({Title = "xanax", Body = ('"%s" will auto load from now on'):format(n)})
        end
    end)
    s:Section("ui")
    local uiBind = s:Bind("toggle ui", Enum.KeyCode.RightShift, function()
        if win.frame and win.frame.Parent then win.frame.Visible = not win.frame.Visible end
    end)
    table.insert(lib.elements, {label = "toggle ui", kind = "bind", get = function() return uiBind.Get().Name end, set = uiBind.Set})
end

function Library:Window(opts)
    opts = opts or {}
    local c = self.colors
    local w, h = opts.Width or 300, opts.Height or 420
    local win = {lib = self, tabs = {}}
    local frame = mk("Frame", {Size = UDim2.fromOffset(w, h), Position = opts.Position or UDim2.new(0.5, -w / 2, 0.5, -h / 2), BackgroundColor3 = c.black, BorderSizePixel = 0, Active = true}, self.gui)
    corner(frame, 8)
    local bg = mk("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = self.image, ImageTransparency = 0.35}, frame)
    corner(bg, 8)
    local bar = mk("Frame", {Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = c.bar, BackgroundTransparency = 0.25, BorderSizePixel = 0}, frame)
    corner(bar, 8)
    local ttl = mk("TextLabel", {Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = opts.Title or self.gui.Name, FontFace = self.font, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left}, bar)
    self:addCycle(ttl)
    local minBtn = mk("TextButton", {Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -56, 0.5, -12), BackgroundColor3 = c.off, Text = "-", FontFace = self.font, TextSize = 14, TextColor3 = c.text}, bar)
    corner(minBtn, 6)
    local closeBtn = mk("TextButton", {Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -28, 0.5, -12), BackgroundColor3 = c.off, Text = "x", FontFace = self.font, TextSize = 14, TextColor3 = c.text}, bar)
    corner(closeBtn, 6)
    local tabbar = mk("Frame", {Position = UDim2.fromOffset(8, 36), Size = UDim2.new(1, -16, 0, 26), BackgroundTransparency = 1}, frame)
    mk("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center}, tabbar)
    local holder = mk("Frame", {Position = UDim2.fromOffset(8, 66), Size = UDim2.new(1, -16, 1, -74), BackgroundTransparency = 1, ClipsDescendants = true}, frame)
    local grip = mk("Frame", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, -2), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Active = true}, frame)
    mk("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "◢", FontFace = self.font, TextSize = 14, TextColor3 = c.sub}, grip)
    local minimized = false
    minBtn.Activated:Connect(function()
        self:Click()
        minimized = not minimized
        tabbar.Visible = not minimized
        holder.Visible = not minimized
        grip.Visible = not minimized
        local target = minimized and UDim2.fromOffset(frame.Size.X.Offset, 32) or frame.Size
        ts:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = target}):Play()
    end)
    closeBtn.Activated:Connect(function()
        self:Click()
        frame:Destroy()
    end)
    local dragging, dragPos, startPos = false, nil, nil
    local resizing, rStart, rSize = false, nil, nil
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragPos, startPos = true, input.Position, frame.Position
        end
    end)
    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            resizing, rStart, rSize = true, input.Position, frame.Size
        end
    end)
    uis.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, resizing = false, false
        end
    end)
    uis.InputChanged:Connect(function(input)
        local move = input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
        if move and frame.Parent then
            if dragging then
                local d = input.Position - dragPos
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            elseif resizing then
                local d = input.Position - rStart
                frame.Size = UDim2.fromOffset(math.max(260, rSize.X.Offset + d.X), math.max(180, rSize.Y.Offset + d.Y))
            end
        end
    end)
    function win:Select(tab)
        for _, t in ipairs(self.tabs) do
            t.scroll.Visible = t == tab
            t.btn.BackgroundColor3 = t == tab and self.lib.colors.on or self.lib.colors.off
        end
        self.selected = tab
    end
    function win:Tab(name, isUser)
        isUser = isUser ~= false
        local btn = mk("TextButton", {Size = UDim2.fromOffset(#name * 8 + 24, 24), BackgroundColor3 = c.off, Text = name, FontFace = self.lib.font, TextSize = 13, TextColor3 = c.text}, tabbar)
        corner(btn, 6)
        self.lib:addCycle(btn)
        if isUser then
            self._ord = (self._ord or 0) + 1
            btn.LayoutOrder = self._ord
        end
        local scroll = mk("ScrollingFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = c.fill, CanvasSize = UDim2.new()}, holder)
        scroll.Visible = false
        mk("UIPadding", {PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4)}, scroll)
        local layout = mk("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scroll.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 8)
        end)
        local tab = setmetatable({lib = self.lib, win = self, btn = btn, scroll = scroll}, Tab)
        btn.Activated:Connect(function()
            self.lib:Click()
            self:Select(tab)
        end)
        table.insert(self.tabs, tab)
        if isUser then self.userCount = (self.userCount or 0) + 1 end
        if #self.tabs == 1 or (isUser and self.userCount == 1) then self:Select(tab) end
        return tab
    end
    function win:Destroy() frame:Destroy() end
    win.frame = frame
    if opts.Settings ~= false then buildSettings(self, win) end
    if self.fs then
        task.delay(1, function()
            if not frame.Parent then return end
            local al = self.meta.autoLoad
            if al and isfile(self:_cfgPath(al)) and self:LoadCfg(al) then
                self.currentCfg = al
                if self._cfgBox and self._cfgBox.Parent then self._cfgBox.Text = al end
                if self._cfgDrop then self._cfgDrop.Set(al, true) end
                self:Notify({Title = "xanax", Body = ('auto loaded "%s"'):format(al)})
            end
        end)
    end
    return win
end

function Library:addCycle(lbl)
    self.phase += 0.45
    table.insert(self.cycling, {lbl = lbl, phase = self.phase})
end

function Tab:Section(text)
    local lbl = mk("TextLabel", {Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = text, FontFace = self.lib.font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, self.scroll)
    self.lib:addCycle(lbl)
    return lbl
end

function Tab:Label(text)
    return mk("TextLabel", {Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = text, FontFace = self.lib.font, TextSize = 13, TextColor3 = self.lib.colors.sub, TextXAlignment = Enum.TextXAlignment.Left}, self.scroll)
end

function Tab:Paragraph(text)
    return mk("TextLabel", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = text, FontFace = self.lib.font, TextSize = 13, TextColor3 = self.lib.colors.text, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top}, self.scroll)
end

function Tab:Toggle(text, default, cb)
    local c = self.lib.colors
    local state = default and true or false
    local btn = mk("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = state and c.on or c.off, Text = text .. ": " .. (state and "ON" or "OFF"), FontFace = self.lib.font, TextSize = 13, TextColor3 = c.text}, self.scroll)
    corner(btn, 6)
    self.lib:addCycle(btn)
    local function apply(v, silent)
        state = v and true or false
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and c.on or c.off
        if not silent and cb then cb(state) end
    end
    btn.Activated:Connect(function()
        self.lib:Click()
        apply(not state)
    end)
    reg(self, text, "toggle", function() return state end, apply)
    return {Set = apply, Get = function() return state end}
end

function Tab:Button(text, cb)
    local btn = mk("TextButton", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = self.lib.colors.off, Text = text, FontFace = self.lib.font, TextSize = 13, TextColor3 = self.lib.colors.text}, self.scroll)
    corner(btn, 6)
    self.lib:addCycle(btn)
    btn.Activated:Connect(function()
        self.lib:Click()
        if cb then cb() end
    end)
    return btn
end

function Tab:Slider(text, min, max, default, cb)
    local c = self.lib.colors
    local value = math.clamp(default or min, min, max)
    local box = mk("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1}, self.scroll)
    local name = mk("TextLabel", {Size = UDim2.new(1, -50, 0, 16), BackgroundTransparency = 1, Text = text, FontFace = self.lib.font, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, box)
    self.lib:addCycle(name)
    local val = mk("TextLabel", {Position = UDim2.new(1, -50, 0, 0), Size = UDim2.fromOffset(50, 16), BackgroundTransparency = 1, Text = fmt(value), FontFace = self.lib.font, TextSize = 13, TextColor3 = c.text, TextXAlignment = Enum.TextXAlignment.Right}, box)
    local track = mk("Frame", {Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = c.track, BorderSizePixel = 0}, box)
    corner(track, 3)
    local fill = mk("Frame", {Size = UDim2.fromScale((value - min) / (max - min), 1), BackgroundColor3 = c.fill, BorderSizePixel = 0}, track)
    corner(fill, 3)
    local function apply(v, silent)
        value = math.clamp(v, min, max)
        fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
        val.Text = fmt(value)
        if not silent and cb then cb(value) end
    end
    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.lib:Click()
            dragging = true
            local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            apply(min + (max - min) * alpha)
        end
    end)
    uis.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            apply(min + (max - min) * alpha)
        end
    end)
    uis.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    reg(self, text, "slider", function() return value end, apply)
    return {Set = apply, Get = function() return value end}
end

function Tab:Dropdown(text, options, default, cb)
    local c = self.lib.colors
    local current = nil
    for _, o in ipairs(options) do if o == default then current = o break end end
    current = current or options[1]
    local box = mk("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1}, self.scroll)
    local btn = mk("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = c.off, Text = text .. ": " .. (current or ""), FontFace = self.lib.font, TextSize = 13, TextColor3 = c.text, ClipsDescendants = true}, box)
    corner(btn, 6)
    self.lib:addCycle(btn)
    local list = mk("Frame", {Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, Visible = false}, box)
    mk("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, list)
    local open = false
    local function apply(v, silent)
        for _, o in ipairs(options) do
            if o == v then
                current = o
                btn.Text = text .. ": " .. o
                if not silent and cb then cb(o) end
                return
            end
        end
    end
    local function rebuild()
        for _, ch in ipairs(list:GetChildren()) do
            if not ch:IsA("UIListLayout") then ch:Destroy() end
        end
        list.Size = UDim2.new(1, 0, 0, #options * 26)
        for _, opt in ipairs(options) do
            local ob = mk("TextButton", {Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = c.track, Text = opt, FontFace = self.lib.font, TextSize = 12, TextColor3 = c.text}, list)
            corner(ob, 4)
            ob.Activated:Connect(function()
                self.lib:Click()
                apply(opt)
                open = false
                list.Visible = false
                box.Size = UDim2.new(1, 0, 0, 30)
            end)
        end
    end
    rebuild()
    btn.Activated:Connect(function()
        self.lib:Click()
        open = not open
        list.Visible = open
        box.Size = UDim2.new(1, 0, 0, open and 34 + #options * 26 or 30)
    end)
    reg(self, text, "dropdown", function() return current end, apply)
    local api = {Set = apply, Get = function() return current end}
    function api.Refresh(newOpts)
        options = newOpts or options
        if current and not table.find(options, current) then current = options[1] end
        btn.Text = text .. ": " .. (current or "")
        rebuild()
        if open then box.Size = UDim2.new(1, 0, 0, 34 + #options * 26) end
    end
    return api
end

function Tab:Textbox(text, placeholder, cb)
    local box = mk("TextBox", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = self.lib.colors.off, PlaceholderText = placeholder or text, Text = "", FontFace = self.lib.font, TextSize = 13, TextColor3 = self.lib.colors.text, PlaceholderColor3 = self.lib.colors.sub, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ClipsDescendants = true}, self.scroll)
    corner(box, 6)
    mk("UIPadding", {PaddingLeft = UDim.new(0, 10)}, box)
    box.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.lib:Click()
        end
    end)
    box.FocusLost:Connect(function(enter)
        if cb then cb(box.Text, enter) end
    end)
    reg(self, text, "text", function() return box.Text end, function(v, silent)
        box.Text = tostring(v)
        if not silent and cb then cb(box.Text, false) end
    end)
    return box
end

function Tab:Bind(text, default, cb)
    local c = self.lib.colors
    local key = default or Enum.KeyCode.Unknown
    local btn = mk("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = c.off, Text = text .. ": " .. key.Name, FontFace = self.lib.font, TextSize = 13, TextColor3 = c.text}, self.scroll)
    corner(btn, 6)
    self.lib:addCycle(btn)
    local listening = false
    local function apply(k, silent)
        if typeof(k) == "EnumItem" then
            key = k
            btn.Text = text .. ": " .. key.Name
        end
    end
    btn.Activated:Connect(function()
        self.lib:Click()
        listening = true
        btn.Text = text .. ": ..."
    end)
    uis.InputBegan:Connect(function(input, gp)
        if gp then return end
        if listening and input.KeyCode ~= Enum.KeyCode.Unknown then
            key = input.KeyCode
            listening = false
            btn.Text = text .. ": " .. key.Name
        elseif not listening and key and input.KeyCode == key then
            if cb then cb() end
        end
    end)
    reg(self, text, "bind", function() return key.Name end, apply)
    return {Set = apply, Get = function() return key end}
end

function Library:Notify(opts)
    local c = self.colors
    local holder = self.gui:FindFirstChild("_notifs")
    if not holder then
        holder = mk("Frame", {Position = UDim2.new(1, -16, 1, -16), AnchorPoint = Vector2.new(1, 1), Size = UDim2.fromOffset(320, 400), BackgroundTransparency = 1}, self.gui)
        mk("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right}, holder)
    end
    local wrap = mk("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1}, holder)
    local card = mk("Frame", {Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(330, 0), BackgroundColor3 = c.black, BackgroundTransparency = 1, BorderSizePixel = 0}, wrap)
    corner(card, 8)
    local bg = mk("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = self.image, ImageTransparency = 0.5}, card)
    corner(bg, 8)
    local ttl = mk("TextLabel", {Position = UDim2.fromOffset(12, 0), Size = UDim2.fromOffset(84, 40), BackgroundTransparency = 1, Text = opts.Title or self.gui.Name, FontFace = self.font, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd}, card)
    self:addCycle(ttl)
    mk("Frame", {Position = UDim2.fromOffset(100, 10), Size = UDim2.fromOffset(1, 20), BackgroundColor3 = c.track, BorderSizePixel = 0}, card)
    mk("TextLabel", {Position = UDim2.fromOffset(108, 0), Size = UDim2.new(1, -120, 1, 0), BackgroundTransparency = 1, Text = opts.Body or "", FontFace = self.font, TextSize = 15, TextColor3 = c.text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd}, card)
    ts:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.fromOffset(0, 0)}):Play()
    task.delay(opts.Time or 4, function()
        ts:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.fromOffset(330, 0)}):Play()
        task.wait(0.25)
        wrap:Destroy()
    end)
end

