    local pop = mk("Frame", {Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(420, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = c.black, BorderSizePixel = 0, Active = true, ZIndex = 11}, modal)
    corner(pop, 10)
